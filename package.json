{
  "name": "@tradexcards/mcp",
  "version": "1.0.0",
  "private": false,
  "description": "MCP Server for trading Pokemon card perpetuals on TradeX (Solana). Search cards, check prices, simulate trades, and execute positions.",
  "main": "dist/index.js",
  "bin": {
    "tradex-mcp": "dist/index.js"
  },
  "homepage": "https://tradex.cards",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tradexcards/mcp.git"
  },
  "bugs": {
    "url": "https://github.com/tradexcards/mcp/issues"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node",
    "start": "bun run dist/index.js",
    "dev": "bun run src/index.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "pokemon",
    "tcg",
    "trading",
    "perpetuals",
    "solana",
    "defi",
    "ai",
    "claude"
  ],
  "author": {
    "name": "ankushKun",
    "url": "https://x.com/ankushKun_"
  },
  "license": "BUSL-1.1",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "@solana/web3.js": "^1.98.4",
    "@solana/spl-token": "^0.4.0"
  },
  "devDependencies": {
    "bun-types": "latest",
    "typescript": "^5.0.0"
  }
}